{%- liquid
  comment
    Renders the mobile drawer navigation and nests further mobile drawers as needed.
    Can show menu images up to the 2nd level if the mobile menu image block is included in the header.

    Required parameters:
      - links: { Object } The linklists[menu].linkslinks or linklists[secondary_menu].links passed through from the header.

    Optional parameters:
      - parents_only: { Boolean } Will not show nested menus if true, ex. in secondary links in the drawer-menu.
      - depth: { Number } Tracking menu depth per iteration of the drawer-menu-list snippet.
      - has_mobile_menu_images: { Boolean } If true, links within the verified menu handle will show images.
      - mobile_menu_image_blocks: { Object } Passing in only the blocks that enable menu images to iterate over.
      - second_level_mobile_menu_image_link_handles: { Object } All second level menu handles to iterate and apply specific block settings.
      - mobile_menu_image_aspect_ratio: { String } Passes the specific block style settings. Can be:
        - Natural, Square, Portrait, Landscape
      - mobile_menu_image_width: { Number } Passes the specific block style settings.
  endcomment

  assign menu_depth = depth | plus: 1 | default: 1
  assign expand_submenus_inline = expand_submenus_inline | default: false
  assign accordion_submenu = accordion_submenu | default: false
  assign last_meganav_inline_parent = ''

  assign children_allowed = true
  if parents_only
    assign children_allowed = false
  endif

  if menu_depth == 1 and expand_submenus_inline and blocks.size > 0
    for link in links
      if link.levels > 0
        assign link_title_handle = link.title | handle | strip

        for block in blocks
          assign dropdown_parent_handle = block.settings.dropdown_parent_link | handle | strip

          if dropdown_parent_handle != blank
            if link.handle == dropdown_parent_handle or link_title_handle == dropdown_parent_handle
              case block.type
                when 'product_meganav', 'compact_meganav', 'full_width_meganav'
                  assign last_meganav_inline_parent = link.handle
              endcase
            endif
          endif
        endfor
      endif
    endfor
  endif
-%}

{%- for link in links -%}
  {%- liquid
    assign show_product = false
    assign meganav_settings = blank
    assign product_list = blank
    assign child_has_mobile_menu_images = false
    assign child_mobile_menu_image_aspect_ratio = blank
    assign child_mobile_menu_image_width = blank

    if menu_depth == 1 and second_level_mobile_menu_image_link_handles contains link.handle
      assign child_has_mobile_menu_images = true

      for block in mobile_menu_image_blocks
        assign current_menu_handle = block.settings.menu_name | handle

        if current_menu_handle == link.handle
          assign child_mobile_menu_image_aspect_ratio = block.settings.aspect_ratio
          assign child_mobile_menu_image_width = block.settings.thumbnail_width
          break
        endif
      endfor
    endif

    assign has_children = false
    if link.levels > 0 and children_allowed
      assign has_children = true
    endif

    assign has_meganav_block = false
    assign link_title_handle = link.title | handle | strip

    if blocks.size > 0 and has_children
      for block in blocks
        assign dropdown_parent_handle = block.settings.dropdown_parent_link | handle | strip
        if dropdown_parent_handle != blank
          if link.handle == dropdown_parent_handle or link_title_handle == dropdown_parent_handle
            if block.type == 'product_meganav' or block.type == 'compact_meganav' or block.type == 'full_width_meganav'
              assign has_meganav_block = true
              break
            endif
          endif
        endif
      endfor
    endif

    assign expand_inline = false
    assign use_accordion = false

    if has_children and expand_submenus_inline
      if menu_depth == 1
        if has_meganav_block
          assign expand_inline = true
        else
          assign use_accordion = true
        endif
      elsif menu_depth > 1
        assign use_accordion = true
      endif
    endif

    assign drawer_link_type_class = ''

    if menu_depth == 1 and expand_inline
      assign drawer_link_type_class = 'fs-subheading-bold fs-body-300'
    elsif accordion_submenu
      assign drawer_link_type_class = 'fs-body-75 ff-body'
    else
      assign drawer_link_type_class = 'ff-heading fs-heading-4-base'
    endif

    assign child_is_active = false
    for link in link.links
      if link.active
        assign child_is_active = true
        break
      elsif link.links.size > 0
        for link in link.links
          if link.active
            assign child_is_active = true
            break
          endif
        endfor
      endif
    endfor

    if blocks.size > 0
      for block in blocks
        assign dropdown_parent_handle = block.settings.dropdown_parent_link | handle | strip
        if link.handle == dropdown_parent_handle and has_children
          if block.type == 'product_meganav'
            assign show_product = true
            assign product_list = block.settings.product_list
            break
          endif
        endif
      endfor

      for block in blocks
        assign meganav_settings_handle = block.settings.dropdown_parent_link | handle | strip
        if link.handle == meganav_settings_handle and has_children
          if block.type == 'full_width_meganav' or block.type == 'compact_meganav'
            assign meganav_settings = block.settings
            break
          endif
        endif
      endfor
    endif
  -%}

  <li
    class="
      drawer-menu__item
      {% if use_accordion -%}
        drawer-menu__item--accordion
      {%- endif %}
      {% if expand_inline and menu_depth == 1 -%}
        drawer-menu__item--inline-expand
      {%- endif %}
      {% if expand_inline and menu_depth == 1 and last_meganav_inline_parent != blank and link.handle == last_meganav_inline_parent -%}
        drawer-menu__item--inline-expand-last
      {%- endif %}
      {% if emphasized -%}
        drawer-menu__item--emphasized
      {%- endif %}
      {% if emphasized and forloop.last -%}
        drawer-menu__item--emphasized-last
      {%- endif %}
    "
    data-list-item
  >
    {%- if use_accordion -%}
      <details class="drawer-menu__accordion">
        <summary
          class="drawer-menu__accordion-trigger drawer-menu__link {{ drawer_link_type_class }} {% if link.active or child_is_active %}active{% endif %}"
        >
          <div class="drawer-menu__link-title">
            {% if has_mobile_menu_images %}
              {% render 'mobile-menu-image-thumbnail',
                link: link,
                aspect_ratio: mobile_menu_image_aspect_ratio,
                thumbnail_width: mobile_menu_image_width
              %}
            {% endif %}

            <span>{{ link.title }}</span>
          </div>
          <div class="drawer-menu__accordion-icons">
            {% render 'icon', icon: 'plus', class: 'menu-icon', view_box_custom: '0 0 14 15' %}
            {% render 'icon', icon: 'minus', class: 'menu-icon', view_box_custom: '0 0 14 15' %}
          </div>
        </summary>

        <div class="drawer-menu__accordion-panel">
          <ul class="drawer-menu__list drawer-menu__list--expand drawer-menu-list--{{ menu_depth }}">
            {%- if meganav_settings.show_featured_products and meganav_settings.featured_products != blank and meganav_settings.product_position == 'left' -%}
              <li class="drawer-menu__item">
                <div class="drawer-menu__item--featured-products">
                  {% for _product in meganav_settings.featured_products %}
                    {%- render 'product-item', prod: _product, aspect_ratio: 'square' -%}
                  {% endfor %}
                </div>
              </li>
            {%- endif -%}

            {% render 'drawer-menu-list',
              links: link.links,
              depth: menu_depth,
              parent_index: parent_index,
              blocks: blocks,
              has_mobile_menu_images: child_has_mobile_menu_images,
              mobile_menu_image_aspect_ratio: child_mobile_menu_image_aspect_ratio,
              mobile_menu_image_width: child_mobile_menu_image_width,
              expand_submenus_inline: true,
              accordion_submenu: true
            %}

            {%- if show_product and product_list != blank -%}
              <li class="draw-menu__item draw-menu__item--product pt-4">
                <div class="grid grid-cols-2 gap-[10px]">
                  {% for product in product_list %}
                    {%- render 'product-item' with
                        prod: product,
                        disable_controls: false
                    -%}
                  {% endfor %}
                </div>
              </li>
            {%- endif -%}

            {%- if meganav_settings.show_featured_products and meganav_settings.featured_products != blank and meganav_settings.product_position == 'right' -%}
              <li class="drawer-menu__item">
                <div class="drawer-menu__item--featured-products">
                  {% for _product in meganav_settings.featured_products %}
                    {%- render 'product-item', prod: _product, aspect_ratio: 'square' -%}
                  {% endfor %}
                </div>
              </li>
            {%- endif -%}
          </ul>
        </div>
      </details>
    {%- elsif has_children == false -%}
      <a
        data-item="link"
        class="drawer-menu__link {{ drawer_link_type_class }} {% if link.active %}active{% endif %}"
        href="{{ link.url }}"
      >
        <div class="drawer-menu__link-title">
          {% if has_mobile_menu_images %}
            {% render 'mobile-menu-image-thumbnail',
              link: link,
              aspect_ratio: mobile_menu_image_aspect_ratio,
              thumbnail_width: mobile_menu_image_width
            %}
          {% endif %}

          <span>{{ link.title }}</span>
        </div>
      </a>
    {%- else -%}
      <a
        data-item="{% if has_children and expand_inline == false and use_accordion == false %}parent{% else %}link{% endif %}"
        class="drawer-menu__link {{ drawer_link_type_class }} {% if has_children and expand_inline == false %}no-transition{% endif %} {% if link.active or child_is_active %}active{% endif %}"
        href="{{ link.url }}"
        {% if has_children and expand_inline == false and use_accordion == false %}
          data-link="primary"
          aria-haspopup="true"
          aria-expanded="false"
        {% endif %}
      >
        <div class="drawer-menu__link-title">
          {% if has_mobile_menu_images %}
            {% render 'mobile-menu-image-thumbnail',
              link: link,
              aspect_ratio: mobile_menu_image_aspect_ratio,
              thumbnail_width: mobile_menu_image_width
            %}
          {% endif %}

          <span>{{ link.title }}</span>
        </div>
        {%- if has_children and expand_inline == false -%}
          {% render 'icon', icon: 'chevron', class: 'menu-icon' %}
        {%- endif -%}
      </a>
    {%- endif -%}

    {%- unless use_accordion -%}
    {% # Inline sub navigation (primary level, expand_submenus_inline) %}
      {%- if expand_inline and link.links.size > 0 -%}
        <ul class="drawer-menu__list drawer-menu__list--expand drawer-menu-list--{{ menu_depth }}">
          {%- if meganav_settings.show_featured_products and meganav_settings.featured_products != blank and meganav_settings.product_position == 'left' -%}
            <li class="drawer-menu__item">
              <div class="drawer-menu__item--featured-products">
                {% for _product in meganav_settings.featured_products %}
                  {%- render 'product-item', prod: _product, aspect_ratio: 'square' -%}
                {% endfor %}
              </div>
            </li>
          {%- endif -%}

          {% render 'drawer-menu-list',
            links: link.links,
            depth: menu_depth,
            parent_index: parent_index,
            blocks: blocks,
            has_mobile_menu_images: child_has_mobile_menu_images,
            mobile_menu_image_aspect_ratio: child_mobile_menu_image_aspect_ratio,
            mobile_menu_image_width: child_mobile_menu_image_width,
            expand_submenus_inline: true
          %}

          {%- if show_product and product_list != blank -%}
            <li class="draw-menu__item draw-menu__item--product pt-4">
              <div class="grid grid-cols-2 gap-[10px]">
                {% for product in product_list %}
                  {%- render 'product-item' with
                      prod: product,
                      disable_controls: false
                  -%}
                {% endfor %}
              </div>
            </li>
          {%- endif -%}

          {%- if meganav_settings.show_featured_products and meganav_settings.featured_products != blank and meganav_settings.product_position == 'right' -%}
            <li class="drawer-menu__item">
              <div class="drawer-menu__item--featured-products">
                {% for _product in meganav_settings.featured_products %}
                  {%- render 'product-item', prod: _product, aspect_ratio: 'square' -%}
                {% endfor %}
              </div>
            </li>
          {%- endif -%}
        </ul>
        {%- if menu_depth == 1 and last_meganav_inline_parent != blank and link.handle == last_meganav_inline_parent -%}
          <div class="drawer-menu__parent-link">
            <a href="{{ link.url }}" class="btn btn--callout btn--dark btn--with-arrow">
              <span>
                {{ 'products.product.shop_all_products' | t }}
                {% render 'icon-new', icon: 'arrow-right' %}
              </span>
            </a>
          </div>
        {%- endif -%}
      {%- elsif link.links.size > 0 and expand_inline == false -%}
        <ul class="drawer-menu__list drawer-menu__list--sub drawer-menu-list--{{ menu_depth }}" aria-hidden="true">
          {% assign header_has_link = false %}
          {% if link.url != '#nolink' %}
            {% assign header_has_link = true %}
          {% endif %}

          {%- capture featured_products_content -%}
              {%- if has_children and meganav_settings.featured_products and meganav_settings.featured_products != blank -%}
                <li class="drawer-menu__item">
                  <div class="drawer-menu__item--featured-products">
                    {% for _product in meganav_settings.featured_products %}
                      {%- render 'product-item', prod: _product, aspect_ratio: 'square' -%}
                    {% endfor %}
                  </div>
                </li>
              {%- endif -%}
            {%- endcapture -%}

          <li class="drawer-menu__item drawer-menu__item--heading">
            <span
              class="drawer-menu__item--heading-back-link"
              data-item="back"
              aria-label="{{ 'general.accessibility.back' | t }}"
            >
              {% render 'icon', icon: 'arrow-long', class: 'back-link-icon' %}
            </span>
            <a
              class="drawer-menu__link"
              data-heading="true"
              {% if header_has_link %}
                href="{{ link.url }}"
              {% endif %}
            >
              <span class="fs-body-300">{{ link.title }}</span>
            </a>
          </li>

          {% if meganav_settings.show_featured_products and meganav_settings.product_position == 'left' %}
            {{ featured_products_content }}
          {% endif %}

          {% render 'drawer-menu-list',
            links: link.links,
            depth: menu_depth,
            parent_index: parent_index,
            has_mobile_menu_images: child_has_mobile_menu_images,
            mobile_menu_image_aspect_ratio: child_mobile_menu_image_aspect_ratio,
            mobile_menu_image_width: child_mobile_menu_image_width
          %}
          {%- unless expand_inline and menu_depth > 1 -%}
            {%- if show_product -%}
              <li class="draw-menu__item draw-menu__item--product pt-4">
                <div class="grid grid-cols-2 gap-[10px]">
                  {% for product in product_list %}
                    {%- render 'product-item' with
                        prod: product,
                        disable_controls: false
                    -%}
                  {% endfor %}
                </div>
              </li>
            {%- endif -%}
          {%- endunless -%}

          {% if meganav_settings.show_featured_products and meganav_settings.product_position == 'right' %}
            {{ featured_products_content }}
          {% endif %}
        </ul>
      {%- endif -%}
    {%- endunless -%}
  </li>
{%- endfor -%}
