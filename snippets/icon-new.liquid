<span class="icon icon-new {{ icon }} {{ class }}">
  {%- case icon -%}
    {%- when 'search' -%}
      <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" fill="none" viewBox="0 0 19 19">
        <circle cx="7.003" cy="7.003" r="6.003" stroke="currentColor" stroke-width="2"/>
        <path stroke="currentColor" stroke-width="2" d="m11.778 11.78 5.991 5.99"/>
      </svg>
    {%- when 'arrow-right' -%}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="9" fill="none" viewBox="0 0 16 9">
        <path stroke="currentColor" d="m11.638 7.9 3.36-3.887-3.36-3.676"/>
        <path fill="currentColor" d="M.5 3.619H0v1h.5v-1m14.498.5v-.5H.5v1h14.498z"/>
      </svg>
    {%- when 'chevron-down' -%}
