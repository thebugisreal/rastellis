{%- comment -%}
  inline video element essentially video 'image'

  Pass in:
  video: URL
  controls: Bool (optional)
  loop: Bool (optional)
  video_pause: Bool (optional, default true)
  wrapper_class: String
  aspect_ratio: String
  focal_alignment: String
  animate: Bool (optional)
{%- endcomment -%}
{%- liquid
  if focal_point
    assign focal_alignment = focal_point | replace: '_', ' '
  endif

  assign video_should_loop = true
  unless loop
    assign video_should_loop = false
  endunless

  assign show_video_pause = true
  if video_pause == false
    assign show_video_pause = false
  endif
-%}

<div
  class="
    video-wrapper {{ wrapper_class }}
    {% if aspect_ratio != blank and aspect_ratio != 'natural' %}aspect-ratio--{{ aspect_ratio }}{% endif %}
    {% if animate %}video-wrapper--animate{% endif %}
  "
  {%- if focal_alignment -%}
    style="--focal-alignment: {{ focal_alignment }};"
  {%- endif -%}
>
  <video
    class="video js-video"
    playsinline
    muted
    {% if video_should_loop %}
      loop
    {% endif %}
    autoplay
    {% comment %}TODO consider delaying autoplay until video is near viewport {% endcomment %}
    src="{{ video }}"
    {% if controls %}
      controls
    {% endif %}
    {% if poster != blank %}
      poster="{{poster}}"
    {% endif %}
  ></video>
  {%- if show_video_pause -%}
    {% render 'video-pause' %}
  {%- endif -%}
</div>
