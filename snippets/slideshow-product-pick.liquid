{%- if product_pick != blank -%}
  {%- liquid
    assign pick_product = product_pick
    assign pick_image = pick_product.featured_media
    assign lowest_price = pick_product.price_min | money

    if pick_product.variants.size > 1
      assign pick_price = 'sections.slideshow.product_pick.starting_at_price_html' | t: price: lowest_price
    else
      assign pick_price = lowest_price
    endif
  -%}

  <div class="slideshow-slide__product-pick">
    <div class="slideshow-slide__product-pick-card">
      {%- if product_pick_label != blank -%}
        <span class="slideshow-slide__product-pick-label fs-body-300">
          {{ product_pick_label }}
        </span>
      {%- endif -%}

      {%- if pick_image != blank -%}
        <a
          class="slideshow-slide__product-pick-image"
          href="{{ pick_product.url }}"
          aria-hidden="true"
          tabindex="-1"
        >
          {%
            render 'image',
            image: pick_image,
            wrapper_class: 'slideshow-slide__product-pick-image-wrapper',
            aspect_ratio: 'square',
            sizes: '75px'
          %}
        </a>
      {%- endif -%}

      <div class="slideshow-slide__product-pick-content">
        <a class="slideshow-slide__product-pick-title fs-body-75" href="{{ pick_product.url }}">
          {{ pick_product.title }}
        </a>
        <p class="slideshow-slide__product-pick-price fs-body-75">
          {{ pick_price }}
        </p>
      </div>

      <a class="slideshow-slide__product-pick-button btn btn--dark btn--small" href="{{ pick_product.url }}">
        <span>{{ 'sections.slideshow.product_pick.shop' | t }}</span>
      </a>
    </div>
  </div>
{%- endif -%}
