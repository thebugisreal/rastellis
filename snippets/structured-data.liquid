{%- if template contains 'index' -%}
  <script type="application/ld+json">
    [
      {
        "@context": "http://schema.org",
        "@type": "Organization",
        "@id": "{{ shop.url }}/#organization_schema",
        "url": "{{ shop.url }}",
        "name": "{{ shop.name | escape }}",
        "email": "{{ shop.email | escape }}",
        "description": "{{ shop.description | escape }}",
        "logo": {
          "@type": "ImageObject",
          "name": "{{ shop.name | escape }} Logo",
          "url": "{{ shop.brand.logo | img_url: '100x' | escape }}"
        },
        "sameAs": [],
        "mainEntityOfPage": {
          "@type": "WebPage",
          "url": "{{ shop.url }}"
        }
      },
      {
        "@context": "http://schema.org",
        "@type": "WebSite",
        "@id": "{{ shop.url }}/#website_schema",
        "name": "{{ shop.name | escape }}",
        "url": "{{ shop.url }}",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "{{ shop.url }}/search?q={query}",
          "name": "{{ shop.name | escape }}",
          "query-input": "required name=query"
        },
        "publisher": {
          "@type": "Organization",
          "@id": "{{ shop.url }}/#organization_schema"
        }
      },
      {
        "@context": "https://schema.org",
        "@type": "OnlineStore",
        "@id": "{{ shop.url }}/#local_business_schema",
        "name": "{{ shop.name | escape }}",
        "alternateName": null,
        "description": "{{ shop.description | escape }}",
        "email": "{{ shop.email | escape }}",
        "telephone": "{{ shop.phone | escape }}",
        "faxNumber": null,
        "image": "{{ shop.brand.logo | img_url: '100x' | escape }}",
        "priceRange": null
      },
      {
        "@context": "http://schema.org",
        "@type": "Corporation",
        "url": "https://{{ shop.url }}"
        {% if shop.phone != blank -%}
          ,"contactPoint": [
            {
              "@type": "ContactPoint",
              "telephone": "{{ shop.phone }}",
              "contactType": "customer service"
            }
          ]
        {%- endif -%}
      },
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "{{ shop.address.city }}",
          "addressRegion": "{{ shop.address.province }}",
          "streetAddress": "{{ shop.address.street }}"
        },
        "description": "{{ shop.description | replace: '"', '\"' | strip_html | split: ' ' | join: ' ' | truncate: 163, '...' | strip }}",
        "name": "{{ shop.name }}",
        "telephone": "{{ shop.phone }}"
      },
      {
        "@context": "http://schema.org",
        "@type": "BreadcrumbList",
        "name": "{{ shop.name | escape }}",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "item": {
              "@type": "WebPage",
              "@id": "{{ shop.url }}",
              "name": "{{ shop.name }}"
            }
          }
        ]
      }
    ]
  </script>
{%- elsif template contains 'collection' -%}
  <script type="application/ld+json">
    [
      {
        "@context": "http://schema.org",
        "@type": "OfferCatalog",
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "{{ collection.url }}"
        },
        "description": "{{ collection.description | strip_html | truncatewords: 30 }}",
        "name": "{{ collection.title | escape }}",
        "url": "{{ collection.url }}",
        "image": "{{ collection.image.src | img_url: '600x600' }}",
        "numberOfItems": "{{ collection.products_count }}",
        "itemListElement": [
          {% for product in collection.products %}
          {
            "@type": "Offer",
            "url": "{{ product.url }}",
            "name": "{{ product.title | escape }}",
            "price": "{{ product.price | divided_by: 100 }}",
            "priceCurrency": "{{ shop.currency }}",
            "availability": "{% if product.available %}http://schema.org/InStock{% else %}http://schema.org/OutOfStock{% endif %}",
            "sku": "{{ product.variants.first.sku }}"
          }
          {% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement":
        [
          {
            "@type": "ListItem",
            "position": 1,
            "item":
            {
              "@id": "{{ routes.root_url | prepend: shop.url }}",
              "name": "{{ 'general.navigation.home' | t }}"
            }
          },
          {%- if current_tags -%}
            {
              "@type": "ListItem",
              "position": 2,
              "item":
              {
                "@id": "{{ collection.url | prepend: shop.url  }}",
                "name": "{{ collection.title }}"
              }
            },
            {
              "@type": "ListItem",
              "position": 3,
              "item":
              {
                "@id": "{{ collection.url | prepend: shop.url }}",
                "name": "{{ current_tags | join: ' + ' }}"
              }
            }
          {%- else -%}
            {
              "@type": "ListItem",
              "position": 2,
              "item":
              {
                "@id": "{{ collection.url | prepend: shop.url }}",
                "name": "{{ collection.title }}"
              }
            }
          {%- endif -%}
        ]
      }
    ]
  </script>
{%- elsif template contains 'product' -%}
  <script type="application/ld+json">
    [
      {
        "@context": "http://schema.org/",
        "@type": "Product",
        "name": {{ product.title | json }},
        "url": {{ product_url | json }},
        {% if product.featured_media -%}
          "image": [{{ product.featured_media | image_url | prepend: 'https:' | json }}],
        {%- endif %}
        "description": {{ product.description | strip_html | json }},
        {% if current_variant.sku != blank -%}
          "sku": {{ current_variant.sku | json }},
        {%- endif %}
        {% if product.metafields.reviews.rating -%}
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "{{- product.metafields.reviews.rating.value | default: 0 -}}",
            "reviewCount": "{{- product.metafields.reviews.rating_count | default: 0 -}}"
          },
        {%- endif %}
        "brand": {
          "@type": "Thing",
          "name": {{ product.vendor | json }}
        },
        "offers": [
          {% for variant in product.variants -%}
            {
              "@type" : "Offer",
              {% if variant.sku != blank -%}
                "sku": {{ variant.sku | json }},
              {%- endif %}
              "availability" : "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
              "price" : {{ variant.price | divided_by: 100.00 | json }},
              "priceCurrency" : {{ cart.currency.iso_code | json }},
              "url" : {{ shop.url | append: variant.url | json }},
              "priceValidUntil": {{ "today" | date: '%s' | plus: 7776000 | date: "%Y-%m-%d" | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor %}
        ]
      },
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement":
        [
          {
            "@type": "ListItem",
            "position": 1,
            "item":
            {
              "@id": "{{ routes.root_url | prepend: shop.url }}",
              "name": "{{ 'general.navigation.home' | t }}"
            }
          },
          {%- if collection.url -%}
            {
              "@type": "ListItem",
              "position": 2,
              "item":
              {
                "@id": "{{ collection.url | prepend: shop.url }}",
                "name": "{{ collection.title }}"
              }
            },
          {%- endif -%}
          {
            "@type": "ListItem",
            "position": {%- if collection.url -%}3{%- else -%}2{%- endif -%},
            "item":
            {
              "@id": "{{ product.url | prepend: shop.url }}",
              "name": "{{ product.title }}"
            }
          }
        ]
      }
    ]
  </script>
{%- elsif template contains 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "NewsArticle",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ article.url }}"
      },
      "headline": "{{ article.title }}",
      "image": [
        "{{ article | image_url }}"
      ],
      "datePublished": "{{ article.published_at }}",
      "dateModified": "{{ article.published_at }}",
      "author": {
        "@type": "Person",
        "name": "{{ article.author }}",
        "url": "{{ shop.url }}{{ article.url }}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "{{ shop.name }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ shop.brand.logo | img_url: '100x' }}"
        }
      },
      "description": "{{ article.excerpt }}"
    }
  </script>
{%- elsif template contains 'page' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebPage",
      "author": {
        "@type": "Person",
        "name": ""
      },
      "creator": null,
      "dateCreated": "{{- page,created_at -}}",
      "dateModified": "{{- page.published_at -}}",
      "datePublished": "{{- page.published_at -}}",
      "headline": "{{- page.title -}}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "url": "{{ shop.url }}{{- page.url -}}"
      },
      "publisher": {
        "@type": "Organization",
        "name": "{{ shop.name }}",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ shop.brand.logo | img_url: '100x' }}"
        }
      },
      "url": "{{ shop.url }}{{- page.url -}}"
    }
  </script>
{%- elsif template contains 'blog' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Blog",
      "@id": "{{ shop.url }}{{- blog.url -}}",
      "mainEntityOfPage": "{{ shop.url }}{{- blog.url -}}",
      "name": {{ blog.title | json }},
      "description": {{- page_description | json -}},
      "publisher": {
        "@type": "Organization",
        "@id": "https://dataliberate.com",
        "name": "Data Liberate",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ shop.brand.logo | img_url: '100x' }}"
        }
      },
      "blogPost": [
        {%- for article in blog.articles -%}
          {
            "@type": "BlogPosting",
            "@id": "{{ shop.url }}{{- article.url -}}",
            "mainEntityOfPage": "{{ shop.url }}{{- article.url -}}",
            "headline": {{- article.title | json -}},
            "name": {{- article.title | json -}},
            "description": {{- article.content | strip_html | json  -}},
            "datePublished": "{{ article.published_at }}",
            "dateModified": "{{ article.published_at }}",
            "author": {
                "@type": "Person",
                "@id": "{{ shop.url }}{{- article.url -}}/#{{article.author}}",
                "url": "{{ shop.url }}{{- article.url -}}/#{{article.author}}",
                "name": {{- article.author | json -}}
            },
            "image": {
              "@type": "ImageObject",
              "@id": "{% if article.image != blank %}{{- article.image | image_url | prepend: 'https:' -}}{% endif %}",
              "url": "{% if article.image != blank %}{{- article.image | image_url | prepend: 'https:' -}}{% endif %}"
            },
            "url": "{{ shop.url }}{{- article.url -}}",
            "keywords": {{ article.tags | json }}
          }
          {% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
