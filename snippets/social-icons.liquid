{%- liquid
  if position == blank
    assign position = 'left'
  endif
  assign social_accounts = 'Facebook, Instagram, LinkedIn, Pinterest, Snapchat, Tiktok, Tumblr, Twitter, Vimeo, WhatsApp, YouTube' | split: ', '
  assign social_count = 0

  for social in social_accounts
    assign social_handle = social | handleize
    assign social_link = 'social_' | append: social_handle | append: '_link'

    if settings[social_link] != blank
      assign social_count = social_count | plus: 1
    endif
  endfor
-%}

{%- if social_count > 0 -%}
  <ul class="social-icons social-icons--{{ position }}" data-count="{{ social_count }}">
    {%- for social in social_accounts -%}
      {%- assign social_handle = social | handleize -%}
      {%- capture social_link -%}social_{{ social_handle }}_link{%- endcapture -%}

      {%- if settings[social_link] != blank -%}
        <li>
          <a
            href="{{ settings[social_link] }}"
            title="{{ 'sections.footer.social_platform' | t: name: shop.name, platform: social }}"
            target="_blank"
            rel="noopener"
          >
            {%- if social_handle == 'facebook' -%}
              {% render 'icon' with icon: social_handle, view_box_custom: '0 0 23 23' %}
            {%- elsif social_handle == 'instagram' -%}
              {% render 'icon' with icon: social_handle, view_box_custom: '0 0 21 21' %}
            {%- elsif social_handle == 'tiktok' -%}
              {% render 'icon' with icon: social_handle, view_box_custom: '0 0 20 23' %}
            {%- elsif social_handle == 'youtube' -%}
              {% render 'icon' with icon: social_handle, view_box_custom: '0 0 25 18' %}
            {%- else -%}
              {% render 'icon' with icon: social_handle %}
            {%- endif -%}
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
