<div
  class="
    testimonials__item
    swiper-slide
    animation--item
  "
  {% unless forloop.first %}
    inert
  {% endunless %}
  data-index="{{ forloop.index0 }}"
  {{ block.shopify_attributes }}
>
  <div class="testimonials__item-panel">
    <div class="testimonials__item-content">
      {%- if block.settings.quote != blank or block.settings.show_rating or block.settings.author != blank -%}
        <blockquote class="testimonials__item-quote">
          <div
            class="testimonials__item-quote-border{% unless quote_border_image != blank %} testimonials__item-quote-border--line{% endunless %}"
            aria-hidden="true"
          >
            {%- if quote_border_image != blank -%}
              {%- render 'image',
                image: quote_border_image,
                wrapper_class: 'testimonials__item-quote-border-image',
                no_crop: true,
                sizes: '6px'
              -%}
            {%- endif -%}
          </div>

          <div class="testimonials__item-quote-body">
            {%- if block.settings.quote != blank -%}
              <span class="testimonials__item-quote-text{% if quote_font == 'heading' %} ff-heading fs-heading-4-base{% else %} ff-body fs-body-75{% endif %}">{{ block.settings.quote }}</span>
            {%- endif -%}

            {%- if block.settings.show_rating or block.settings.author != blank -%}
              <div class="testimonials__item-meta">
                {%- if block.settings.author != blank -%}
                  <cite class="testimonials__item-author ff-subheading ff-secondary fs-body-250">
                    <span>{{ block.settings.author }}</span>
                  </cite>
                {%- endif -%}
                {%- if block.settings.show_rating -%}
                  <div class="testimonials__item-stars">
                    {%- render 'star-rating', rating: block.settings.rating -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </blockquote>
      {%- endif -%}
    </div>

    {%- if block.settings.product != blank -%}
      <div class="testimonials__item-product-pick">
        {%- render 'product-pick-card',
          product: block.settings.product,
          image: block.settings.image,
          image_sizes: '(min-width: 720px) 77px, 60px'
        -%}
      </div>
    {%- endif -%}

    {%- if block.settings.sticker != blank -%}
      <div class="testimonials__item-sticker" aria-hidden="true">
        {%- render 'image',
          image: block.settings.sticker,
          wrapper_class: 'testimonials__item-sticker-image',
          sizes: '440px',
          aspect_ratio: 'externally_set',
          object_fit: 'contain'
        -%}
      </div>
    {%- endif -%}
  </div>
</div>
