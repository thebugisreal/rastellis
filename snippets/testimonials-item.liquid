{%- liquid
  assign product_image = block.settings.product.featured_media | default: block.settings.product.media[0].preview_image

  if block.settings.image != blank
    assign product_image = block.settings.image
  endif

  if image_size == "small"
    assign image_sizes_fraction = 0.30
  elsif image_size == "medium"
    assign image_sizes_fraction = 0.40
  elsif image_size == "large"
    assign image_sizes_fraction = 0.50
  else
    assign image_sizes_fraction = 0.40
  endif

  assign pick_product = block.settings.product
  assign pick_price = blank

  if pick_product != blank
    assign lowest_price = pick_product.price_min | money

    if pick_product.variants.size > 1
      assign pick_price = 'sections.slideshow.product_pick.starting_at_price_html' | t: price: lowest_price
    else
      assign pick_price = lowest_price
    endif
  endif
-%}

{% capture product_pick_image_sizes -%}
  (min-width: 720px) calc((100vw - (2 * clamp(18px, 3.3vw, 3.3vw))) * {{ image_sizes_fraction }} * 0.5), 75px
{%- endcapture %}

<div
  class="
    testimonials__item
    testimonials__item--image-{{ image_size }}
    swiper-slide
    animation--item
  "
  {% unless forloop.first %}
    inert
  {% endunless %}
  data-index="{{ forloop.index0 }}"
  {{ block.shopify_attributes }}
>
  <div class="testimonials__item-panel">
    <div class="testimonials__item-content">
      {%- if block.settings.quote != blank -%}
        <blockquote class="testimonials__item-quote {% if quote_font == 'heading' %}ff-subheading fs-heading-4-base{% else %}ff-body fs-body-300 fs-body-350-above-720{% endif %}">
          {{ block.settings.quote }}
        </blockquote>
      {%- endif -%}

      {%- if block.settings.show_rating or block.settings.author != blank -%}
        <div class="testimonials__item-meta">
          {%- if block.settings.show_rating -%}
            <div class="testimonials__item-stars">
              {%- render 'star-rating', rating: block.settings.rating -%}
            </div>
          {%- endif -%}

          {%- if block.settings.author != blank -%}
            <cite class="testimonials__item-author ff-subheading ff-secondary">
              <span>{{ block.settings.author }}</span>
            </cite>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if pick_product != blank -%}
      <div class="testimonials__item-product-pick">
        <div class="testimonials__item-product-pick-card">
          {%- if product_image != blank -%}
            <a
              class="testimonials__item-product-pick-image"
              href="{{ pick_product.url }}"
              aria-hidden="true"
              tabindex="-1"
            >
              {%
                render 'image',
                image: product_image,
                wrapper_class: 'testimonials__item-product-pick-image-wrapper',
                aspect_ratio: 'square',
                sizes: product_pick_image_sizes
              %}
            </a>
          {%- endif -%}

          <div class="testimonials__item-product-pick-content">
            <a class="testimonials__item-product-pick-title fs-body-75" href="{{ pick_product.url }}">
              {{ pick_product.title }}
            </a>
            {%- if pick_price != blank -%}
              <p class="testimonials__item-product-pick-price fs-body-75">
                {{ pick_price }}
              </p>
            {%- endif -%}
          </div>

          <a class="testimonials__item-product-pick-button btn btn--dark btn--small" href="{{ pick_product.url }}">
            <span>{{ 'sections.slideshow.product_pick.shop' | t }}</span>
          </a>
        </div>
      </div>
    {%- endif -%}

    {%- if block.settings.sticker != blank -%}
      <div class="testimonials__item-sticker" aria-hidden="true">
        {%- render 'image',
          image: block.settings.sticker,
          wrapper_class: 'testimonials__item-sticker-image',
          sizes: '440px',
          aspect_ratio: 'natural'
        -%}
      </div>
    {%- endif -%}
  </div>
</div>
