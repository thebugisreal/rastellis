{%- liquid
  assign patterns = settings.delay_javascript_patterns | newline_to_br | split: '<br />'
  assign blacklist = ''

  for pattern in patterns
    assign pattern_strip = pattern | strip

    unless pattern_strip == blank
      assign blacklist = blacklist | append: '|*|' | append: pattern_strip
    endunless
  endfor
-%}

