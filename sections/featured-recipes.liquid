{%- liquid
  assign featured_article = section.settings.featured_article
  assign featured_video_url = featured_article.metafields.custom.user_curated_vertical_video.value.sources[0].url
  assign source_mode = section.settings.source_mode | default: 'manual'
  assign set_limit = 4
  if featured_article != blank
    assign set_limit = 3
  endif
-%}

<div class="featured-recipes section"
  data-section-id="{{ section.id }}"
  data-section-type="featured-recipes"
>
  <div class="featured-recipes__inner page-width">
    <div class="featured-recipes__header">
      <h2 class="featured-recipes__title ff-heading fs-heading-3-base{% if section.settings.title_alignment == 'center' %} featured-recipes__title--center{% endif %}">
        {{ section.settings.title | escape }}
      </h2>
      <div class="featured-recipes__header-cta">
        {%- render 'button-block',
          label: section.settings.button_label,
          link: section.settings.button_url,
          button_style: 'btn--callout',
          button_color: 'btn--dark',
          icon: 'arrow-long',
          view_box_custom: '0 0 16 9'
        -%}
      </div>
    </div>

    <div class="featured-recipes__cards carousel swiper">
      <div class="featured-recipes__cards-inner carousel__wrapper swiper-wrapper">
        {%- if source_mode == 'auto' and section.settings.blog != blank -%}
          {%- for article in section.settings.blog.articles limit: set_limit -%}
            <div class="featured-recipes__card carousel__slide swiper-slide">
              {%- render 'recipe-card', article: article -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks limit: set_limit -%}
            {%- assign card_article = block.settings.article -%}
            <div class="featured-recipes__card carousel__slide swiper-slide" {{ block.shopify_attributes }}>
              {%- if card_article != blank -%}
                {%- render 'recipe-card', article: card_article -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%}4th card is a section setting (featured_article), not a block — no shopify_attributes{%- endcomment -%}
        {%- if featured_article != blank -%}
          <div class="featured-recipes__card carousel__slide swiper-slide">
            {%- render 'recipe-card',
              article: featured_article,
              featured: true,
              video_url: featured_video_url,
              overlay_text: section.settings.featured_article_overlay_text
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="featured-recipes__mobile-footer">
      {%- render 'carousel-navigation' with wrapper_class: 'featured-recipes__navigation-buttons' -%}
      <div class="featured-recipes__mobile-cta">
        {%- render 'button-block',
          label: section.settings.button_label,
          link: section.settings.button_url,
          button_style: 'btn--callout',
          button_color: 'btn--dark',
          icon: 'arrow-long',
          view_box_custom: '0 0 16 9',
          button_alignment: 'center',
          button_alignment_mobile: 'center'
        -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_recipes.name",
  "tag": "section",
  "class": "featured-recipes-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured_recipes.settings.title.label",
      "default": "Discover Ways to Enjoy Rastelli's"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "t:sections.featured_recipes.settings.title_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.featured_recipes.settings.title_alignment.option_left" },
        { "value": "center", "label": "t:sections.featured_recipes.settings.title_alignment.option_center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.featured_recipes.settings.button_label.label",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.featured_recipes.settings.button_url.label"
    },
    {
      "type": "select",
      "id": "source_mode",
      "label": "t:sections.featured_recipes.settings.source_mode.label",
      "options": [
        { "value": "manual", "label": "t:sections.featured_recipes.settings.source_mode.option_manual" },
        { "value": "auto", "label": "t:sections.featured_recipes.settings.source_mode.option_auto" }
      ],
      "default": "manual",
      "info": "t:sections.featured_recipes.settings.source_mode.info"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured_recipes.settings.blog.label",
      "info": "t:sections.featured_recipes.settings.blog.info"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "t:sections.featured_recipes.settings.featured_article.label",
      "info": "t:sections.featured_recipes.settings.featured_article.info"
    },
    {
      "type": "text",
      "id": "featured_article_overlay_text",
      "label": "t:sections.featured_recipes.settings.featured_article_overlay_text.label",
      "default": "User Created Recipe"
    }
  ],
  "blocks": [
    {
      "type": "recipe_card",
      "name": "t:sections.featured_recipes.blocks.recipe_card.name",
      "limit": 4,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "t:sections.featured_recipes.blocks.recipe_card.settings.article.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_recipes.presets.name"
    }
  ]
}
{% endschema %}
