{%- liquid
  assign featured_article = section.settings.featured_article
  assign featured_video_url = featured_article.metafields.custom.user_curated_vertical_video.value.url
  assign source_mode = section.settings.source_mode | default: 'manual'
-%}

<div class="featured-recipes section"
  data-section-id="{{ section.id }}"
  data-section-type="featured-recipes"
>
  <div class="featured-recipes__inner page-width">

    <div class="featured-recipes__header">
      <h2 class="featured-recipes__title ff-heading fs-heading-3-base{% if section.settings.title_alignment == 'center' %} featured-recipes__title--center{% endif %}">
        {{ section.settings.title | escape }}
      </h2>
      <div class="featured-recipes__header-cta">
        {%- render 'button-block',
          label: section.settings.button_label,
          link: section.settings.button_url,
          button_style: 'btn--callout',
          button_color: 'btn--dark',
          icon: 'arrow-long',
          view_box_custom: '0 0 16 9'
        -%}
      </div>
    </div>

    <div class="featured-recipes__cards carousel swiper">
      <div class="featured-recipes__cards-inner carousel__wrapper swiper-wrapper">

        {%- if source_mode == 'auto' and section.settings.blog != blank -%}
          {%- for article in section.settings.blog.articles limit: 3 -%}
            <div class="featured-recipes__card carousel__slide swiper-slide">
              {%- render 'recipe-card', article: article -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign card_article = block.settings.article -%}
            <div class="featured-recipes__card carousel__slide swiper-slide" {{ block.shopify_attributes }}>
              {%- if card_article != blank -%}
                {%- render 'recipe-card', article: card_article -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%}4th card is a section setting (featured_article), not a block — no shopify_attributes{%- endcomment -%}
        <div class="featured-recipes__card carousel__slide swiper-slide">
          {%- if featured_article != blank -%}
            {%- render 'recipe-card',
              article: featured_article,
              featured: true,
              video_url: featured_video_url
            -%}
          {%- endif -%}
        </div>

      </div>
    </div>

    <div class="featured-recipes__mobile-footer">
      {%- render 'carousel-navigation' with wrapper_class: 'featured-recipes__navigation-buttons' -%}
      <div class="featured-recipes__mobile-cta">
        {%- render 'button-block',
          label: section.settings.button_label,
          link: section.settings.button_url,
          button_style: 'btn--callout',
          button_color: 'btn--dark',
          icon: 'arrow-long',
          view_box_custom: '0 0 16 9'
        -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Featured Recipes",
  "tag": "section",
  "class": "featured-recipes-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Discover Ways to Enjoy Rastelli's"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore All"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "source_mode",
      "label": "Card source (positions 1–3)",
      "options": [
        { "value": "manual", "label": "Manual (use blocks below)" },
        { "value": "auto", "label": "Auto (pull from blog)" }
      ],
      "default": "manual",
      "info": "In auto mode, the first 3 articles from the selected blog fill positions 1–3 automatically."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (auto mode)",
      "info": "Only used when Card source is set to Auto."
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured video article",
      "info": "Appears in the 4th card position with a play/pause video."
    }
  ],
  "blocks": [
    {
      "type": "recipe_card",
      "name": "Recipe card",
      "limit": 3,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Recipes"
    }
  ]
}
{% endschema %}
