<div
  class="
    text-cta-strip
    section
    section--vertical-padding-text-cta-strip
    {{ section.settings.section_padding }}
    section--divider-{{ section.settings.divider_style }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
    {% endif %}
    link-color-scheme--{{ section.settings.link_color_scheme }}
  "
  data-section-id="{{ section.id }}"
  data-section-type="text-cta-strip"
>
  <div class="text-cta-strip__inner">

    {%- unless section.settings.text == blank -%}
      <div class="text-cta-strip__body ff-heading {{ section.settings.body_font_class }}">
        {{ section.settings.text }}
      </div>
    {%- endunless -%}

    {%- unless section.settings.cta_image == blank -%}
      <div class="text-cta-strip__cta-wrap">
        {%- if section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="text-cta-strip__cta">
        {%- else -%}
          <div class="text-cta-strip__cta">
        {%- endif -%}
            {%- render 'image',
              image: section.settings.cta_image,
              wrapper_class: 'text-cta-strip__cta-image',
              sizes: '(min-width: 720px) 190px, 195px'
            -%}
        {%- if section.settings.cta_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </div>
    {%- endunless -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.text_cta_strip.name",
  "tag": "section",
  "class": "text-cta-strip-wrap",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.text_cta_strip.settings.text.label"
    },
    {
      "type": "select",
      "id": "body_font_class",
      "label": "t:sections.text_cta_strip.settings.body_font_class.label",
      "default": "fs-heading-3-base",
      "options": [
        { "value": "fs-heading-1-base", "label": "t:shared.settings.heading_font_class.option_heading_1" },
        { "value": "fs-heading-2-base", "label": "t:shared.settings.heading_font_class.option_heading_2" },
        { "value": "fs-heading-3-base", "label": "t:shared.settings.heading_font_class.option_heading_3" },
        { "value": "fs-heading-4-base", "label": "t:shared.settings.heading_font_class.option_heading_4" },
        { "value": "fs-heading-5-base", "label": "t:shared.settings.heading_font_class.option_heading_5" },
        { "value": "fs-heading-6-base", "label": "t:shared.settings.heading_font_class.option_heading_6" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.text_cta_strip.settings.cta_header.content"
    },
    {
      "type": "image_picker",
      "id": "cta_image",
      "label": "t:sections.text_cta_strip.settings.cta_image.label",
      "info": "t:sections.text_cta_strip.settings.cta_image.info"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.text_cta_strip.settings.cta_link.label"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header_style.content"
    },
    {
      "id": "enable_animation",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "default": "none",
      "options": [
        { "label": "t:shared.settings.section_style.divider_style.option_none", "value": "none" },
        { "label": "t:shared.settings.section_style.divider_style.option_solid", "value": "solid" }
      ]
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "default": "section--vertical-padding-top-bottom",
      "options": [
        { "label": "t:shared.settings.section_style.section_padding.option_none", "value": "section--vertical-padding-none" },
        { "label": "t:shared.settings.section_style.section_padding.option_both", "value": "section--vertical-padding-top-bottom" },
        { "label": "t:shared.settings.section_style.section_padding.option_top", "value": "section--vertical-padding-top-only" },
        { "label": "t:shared.settings.section_style.section_padding.option_bottom", "value": "section--vertical-padding-bottom-only" }
      ]
    },
    {
      "type": "select",
      "id": "link_color_scheme",
      "label": "t:shared.settings.link_color_scheme.label",
      "default": "dark",
      "options": [
        { "value": "light", "label": "t:shared.settings.link_color_scheme.option_light" },
        { "value": "dark", "label": "t:shared.settings.link_color_scheme.option_dark" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.text_cta_strip.presets.name"
    }
  ]
}
{% endschema %}
