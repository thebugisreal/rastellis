<div
  class="
    spend-and-save
    section
    section--vertical-padding-spend-and-save
    {{ section.settings.section_padding }}
    section--divider-{{ section.settings.divider_style }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
    {% endif %}
    link-color-scheme--{{ section.settings.link_color_scheme }}
  "
  style="
    --spend-and-save-col1-text-color: {{ section.settings.col1_text_color }};
    --spend-and-save-col2-text-color: {{ section.settings.col2_text_color }};
  "
  data-section-id="{{ section.id }}"
  data-section-type="spend-and-save"
>
  <div class="spend-and-save__inner">

    <div class="spend-and-save__intro">
      {%- unless section.settings.badge_image == blank -%}
        <div class="spend-and-save__badge-wrap">
          {%- render 'image',
            image: section.settings.badge_image,
            wrapper_class: 'spend-and-save__badge',
            sizes: '120px'
          -%}
        </div>
      {%- endunless -%}

      {%- unless section.settings.heading == blank -%}
        <h2 class="spend-and-save__heading ff-heading fs-heading-3-base">
          {{ section.settings.heading }}
        </h2>
      {%- endunless -%}

      {%- unless section.settings.body == blank -%}
        <div class="spend-and-save__body ff-body fs-body-75 rte">
          {{ section.settings.body }}
        </div>
      {%- endunless -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="spend-and-save__table" role="table" aria-label="{{ section.settings.heading }}">

        <div class="spend-and-save__row spend-and-save__row--header" role="row">
          <div class="spend-and-save__cell spend-and-save__cell--feature spend-and-save__cell--header" role="columnheader">
            {%- unless section.settings.feature_header_label == blank -%}
              <span class="ff-heading ff-secondary fs-heading-6-base">{{ section.settings.feature_header_label }}</span>
            {%- endunless -%}
          </div>
          <div class="spend-and-save__cell spend-and-save__cell--col1 spend-and-save__cell--header" role="columnheader">
            {%- unless section.settings.col1_logo == blank -%}
              {%- render 'image', image: section.settings.col1_logo, wrapper_class: 'spend-and-save__col-logo', sizes: '157px' -%}
            {%- endunless -%}
            {%- unless section.settings.col1_label == blank -%}
              <span class="ff-heading ff-secondary fs-heading-6-base">{{ section.settings.col1_label }}</span>
            {%- endunless -%}
          </div>
          <div class="spend-and-save__cell spend-and-save__cell--col2 spend-and-save__cell--header" role="columnheader">
            {%- unless section.settings.col2_logo == blank -%}
              {%- render 'image', image: section.settings.col2_logo, wrapper_class: 'spend-and-save__col-logo', sizes: '157px' -%}
            {%- endunless -%}
            {%- unless section.settings.col2_label == blank -%}
              <span class="ff-heading ff-secondary fs-heading-6-base">{{ section.settings.col2_label }}</span>
            {%- endunless -%}
          </div>
        </div>

        {%- for block in section.blocks -%}
          <div
            class="spend-and-save__row spend-and-save__row--feature{% if forloop.last %} spend-and-save__row--last{% endif %}"
            role="row"
            {{ block.shopify_attributes }}
          >
            <div class="spend-and-save__cell spend-and-save__cell--feature" role="rowheader">
              <span class="ff-heading ff-secondary fs-body-300">{{ block.settings.title }}</span>
            </div>
            <div class="spend-and-save__cell spend-and-save__cell--col1" role="cell">
              <span class="ff-body fs-body-50">{{ block.settings.col1_value }}</span>
            </div>
            <div class="spend-and-save__cell spend-and-save__cell--col2" role="cell">
              <span class="ff-body fs-body-50">{{ block.settings.col2_value }}</span>
            </div>
          </div>
        {%- endfor -%}

      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.spend_and_save.name",
  "tag": "section",
  "class": "spend-and-save-wrap",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.spend_and_save.settings.heading.label",
      "default": "Butcher Quality, Unmatched Value"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:sections.spend_and_save.settings.body.label"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "t:sections.spend_and_save.settings.badge_image.label",
      "info": "t:sections.spend_and_save.settings.badge_image.info"
    },
    {
      "type": "header",
      "content": "t:sections.spend_and_save.settings.table_columns_header.content"
    },
    {
      "type": "text",
      "id": "feature_header_label",
      "label": "t:sections.spend_and_save.settings.feature_header_label.label",
      "default": "Cart Size"
    },
    {
      "type": "color",
      "id": "col1_text_color",
      "label": "t:sections.spend_and_save.settings.col1_text_color.label",
      "default": "#AF0440"
    },
    {
      "type": "text",
      "id": "col1_label",
      "label": "t:sections.spend_and_save.settings.col1_label.label",
      "default": "Us"
    },
    {
      "type": "image_picker",
      "id": "col1_logo",
      "label": "t:sections.spend_and_save.settings.col1_logo.label"
    },
    {
      "type": "color",
      "id": "col2_text_color",
      "label": "t:sections.spend_and_save.settings.col2_text_color.label",
      "default": "#5B5B5B"
    },
    {
      "type": "text",
      "id": "col2_label",
      "label": "t:sections.spend_and_save.settings.col2_label.label",
      "default": "Supermarkets"
    },
    {
      "type": "image_picker",
      "id": "col2_logo",
      "label": "t:sections.spend_and_save.settings.col2_logo.label"
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header_style.content"
    },
    {
      "id": "enable_animation",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "default": "none",
      "options": [
        { "label": "t:shared.settings.section_style.divider_style.option_none", "value": "none" },
        { "label": "t:shared.settings.section_style.divider_style.option_solid", "value": "solid" }
      ]
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "default": "section--vertical-padding-top-bottom",
      "options": [
        { "label": "t:shared.settings.section_style.section_padding.option_none", "value": "section--vertical-padding-none" },
        { "label": "t:shared.settings.section_style.section_padding.option_both", "value": "section--vertical-padding-top-bottom" },
        { "label": "t:shared.settings.section_style.section_padding.option_top", "value": "section--vertical-padding-top-only" },
        { "label": "t:shared.settings.section_style.section_padding.option_bottom", "value": "section--vertical-padding-bottom-only" }
      ]
    },
    {
      "type": "select",
      "id": "link_color_scheme",
      "label": "t:shared.settings.link_color_scheme.label",
      "default": "dark",
      "options": [
        { "value": "light", "label": "t:shared.settings.link_color_scheme.option_light" },
        { "value": "dark", "label": "t:shared.settings.link_color_scheme.option_dark" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.spend_and_save.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.spend_and_save.blocks.row.settings.title.label"
        },
        {
          "type": "text",
          "id": "col1_value",
          "label": "t:sections.spend_and_save.blocks.row.settings.col1_value.label"
        },
        {
          "type": "text",
          "id": "col2_value",
          "label": "t:sections.spend_and_save.blocks.row.settings.col2_value.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.spend_and_save.presets.name",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
