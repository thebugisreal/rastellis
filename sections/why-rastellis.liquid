{%- liquid
  assign has_background_color = false
  if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)'
    assign has_background_color = true
  endif

  assign has_wave_top = false
  if section.settings.enable_wave_top_desktop or section.settings.enable_wave_top_mobile
    assign has_wave_top = true
  endif

  assign has_wave_bottom = false
  if section.settings.enable_wave_bottom_desktop or section.settings.enable_wave_bottom_mobile
    assign has_wave_bottom = true
  endif

  assign has_rough_border = false
  if has_wave_top or has_wave_bottom
    assign has_rough_border = true
  endif
-%}

{%- capture section_classes -%}
  section section--divider-{{ section.settings.divider_style }}
  section--vertical-padding-why-rastellis
  {{ section.settings.section_padding }}
{%- endcapture -%}

<div
  data-section-id="{{ section.id }}"
  data-section-type="why-rastellis"
  class="
    why-rastellis
    {{ section_classes }}
    section--full-width
    why-rastellis--media-{{ section.settings.media_position }}
    {% if section.blocks.size <= 1 %}why-rastellis--single-slide{% endif %}
    {% if section.settings.enable_wave_top_desktop %}rough-border--top-desktop{% endif %}
    {% if section.settings.enable_wave_top_mobile %}rough-border--top-mobile{% endif %}
    {% if section.settings.enable_wave_bottom_desktop %}rough-border--bottom-desktop{% endif %}
    {% if section.settings.enable_wave_bottom_mobile %}rough-border--bottom-mobile{% endif %}
    {% if has_rough_border %}has-rough-border{% endif %}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--why-rastellis
    {% endif %}
  "
  style="
    {% if has_background_color %}
      --section-background-color: {{ section.settings.background_color }};
    {% endif %}
  "
>
  {%- if has_wave_top -%}
    {%- render 'wave', position: 'top' -%}
  {%- endif -%}

  <div class="why-rastellis__inner">

    <div class="why-rastellis__carousel swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div
            class="why-rastellis__slide swiper-slide animation--item"
            {% unless forloop.first %}inert{% endunless %}
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            {%- if section.settings.badge_image != blank -%}
              <div class="why-rastellis__badge" aria-hidden="true">
                {%- render 'image',
                  image: section.settings.badge_image,
                  wrapper_class: 'why-rastellis__badge-image',
                  include_placeholder: false,
                  loading: 'lazy',
                  sizes: '139px'
                -%}
              </div>
            {%- endif -%}

            <div class="why-rastellis__text">
              {%- if block.settings.show_eyebrow and block.settings.eyebrow != blank -%}
                <p class="why-rastellis__eyebrow ff-subheading ff-secondary fs-body-200">
                  {{ block.settings.eyebrow }}
                </p>
              {%- endif -%}

              {%- if block.settings.headline != blank -%}
                <h2 class="why-rastellis__headline ff-heading fs-heading-3-base">
                  {{ block.settings.headline }}
                </h2>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <div class="why-rastellis__body fs-body-75">
                  {{ block.settings.body }}
                </div>
              {%- endif -%}
            </div>

            <div class="why-rastellis__media">
              {%- render 'why-rastellis-slide', block: block -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        {%- render 'carousel-navigation' -%}
      {%- endif -%}
    </div>

  </div>

  {%- if has_wave_bottom -%}
    {%- render 'wave', position: 'bottom' -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.why_rastellis.name",
  "tag": "section",
  "class": "shopify-section--full-width",
  "disabled_on": {
    "groups": ["header", "custom.overlay"],
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "t:sections.why_rastellis.settings.badge_image.label",
      "info": "t:sections.why_rastellis.settings.badge_image.info"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.why_rastellis.settings.background_color.label",
      "default": "#E7E6DE"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:sections.why_rastellis.settings.media_position.label",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "t:sections.why_rastellis.settings.media_position.option__left"
        },
        {
          "value": "right",
          "label": "t:sections.why_rastellis.settings.media_position.option__right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header_style.content"
    },
    {
      "id": "enable_animation",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "info": "t:shared.settings.section_style.enable_animation.info",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "default": "none",
      "options": [
        {
          "label": "t:shared.settings.section_style.divider_style.option_none",
          "value": "none"
        },
        {
          "label": "t:shared.settings.section_style.divider_style.option_solid",
          "value": "solid"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "default": "section--vertical-padding-top-bottom",
      "options": [
        {
          "label": "t:shared.settings.section_style.section_padding.option_none",
          "value": "section--vertical-padding-none"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_both",
          "value": "section--vertical-padding-top-bottom"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_top",
          "value": "section--vertical-padding-top-only"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_bottom",
          "value": "section--vertical-padding-bottom-only"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": "t:shared.settings.rough_border.info"
    },
    {
      "type": "checkbox",
      "id": "enable_wave_top_desktop",
      "label": "t:shared.settings.rough_border.enable_wave_top_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_wave_bottom_desktop",
      "label": "t:shared.settings.rough_border.enable_wave_bottom_desktop.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_wave_top_mobile",
      "label": "t:shared.settings.rough_border.enable_wave_top_mobile.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_wave_bottom_mobile",
      "label": "t:shared.settings.rough_border.enable_wave_bottom_mobile.label",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.why_rastellis.blocks.slide.name",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "headline",
          "label": "t:sections.why_rastellis.blocks.slide.settings.headline.label",
          "default": "Delicious Meat, Responsibly Sourced from Trusted Farms"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.why_rastellis.blocks.slide.settings.body.label",
          "default": "Rastelli's partners with trusted family farms and fisheries to source high-quality meat that is humanely raised, responsibly harvested, and free from unnecessary antibiotics and added hormones."
        },
        {
          "type": "header",
          "content": "t:sections.why_rastellis.blocks.slide.settings.header__eyebrow.content"
        },
        {
          "type": "checkbox",
          "id": "show_eyebrow",
          "label": "t:sections.why_rastellis.blocks.slide.settings.show_eyebrow.label",
          "default": false
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.why_rastellis.blocks.slide.settings.eyebrow.label"
        },
        {
          "type": "header",
          "content": "t:sections.why_rastellis.blocks.slide.settings.header__media.content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.why_rastellis.blocks.slide.settings.image.label"
        },
        {
          "type": "video",
          "id": "video_hosted",
          "label": "t:sections.why_rastellis.blocks.slide.settings.video_hosted.label",
          "info": "t:sections.why_rastellis.blocks.slide.settings.video_hosted.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.why_rastellis.presets.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "headline": "Delicious Meat, Responsibly Sourced from Trusted Farms",
            "body": "Rastelli's partners with trusted family farms and fisheries to source high-quality meat that is humanely raised, responsibly harvested, and free from unnecessary antibiotics and added hormones.",
            "show_eyebrow": false
          }
        },
        {
          "type": "slide",
          "settings": {
            "headline": "Cut, Frozen, Packed, & Shipped On Site",
            "body": "Rastelli's partners with trusted family farms and fisheries to source high-quality meat that is humanely raised, responsibly harvested, and free from unnecessary antibiotics and added hormones.",
            "show_eyebrow": false
          }
        },
        {
          "type": "slide",
          "settings": {
            "headline": "Unmatched Flavor",
            "body": "Rastelli's partners with trusted family farms and fisheries to source high-quality meat that is humanely raised, responsibly harvested, and free from unnecessary antibiotics and added hormones.",
            "show_eyebrow": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
