{%- render 'asset' with 'template-blog.css' -%}

{%- comment -%} theme-check-disable UnusedAssign {%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]

  assign featured_video_url = blank
  assign featured_video_label = blank
  assign replace_article_position = 0
  assign has_featured_video = false

  for block in section.blocks
    if block.type == 'video'
      assign featured_video_url = block.settings.video_url
      assign featured_video_label = block.settings.overlay_text
      assign replace_article_position = block.settings.replace_article_position | strip | plus: 0

      if featured_video_url != blank
        assign has_featured_video = true
      endif

      break
    endif
  endfor
-%}
{%- comment -%} theme-check-enable UnusedAssign {%- endcomment -%}

{%- capture section_header -%}
  <div class="section-introduction animation--section-introduction blog-posts__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="blog-posts__heading ff-heading fs-heading-3-base section-introduction__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.link_text -%}
      {%-
        render 'button-block' with
        wrapper_class: "blog-posts__header-button blog-posts__header-button--desktop section-introduction__button",
        link: section.settings.button_link | default: blog.url,
        label: section.settings.link_text,
        button_style: "btn--callout",
        icon: "arrow-long",
        view_box_custom: "0 0 16 9"
      -%}
    {%- endif -%}
  </div>
{%- endcapture -%}
{%- assign section_header = section_header | strip -%}

<div
  class="
    blog-posts
    section
    section--vertical-padding-large
    section--divider-{{ section.settings.divider_style }}
    {% if settings.enable_section_animations and section.settings.enable_animation %}
      animation
      animation--blog-posts
    {% endif %}
    link-color-scheme--{{ section.settings.link_color_scheme }}
  "
  data-section-id="{{ section.id }}"
  data-section-type="blog-posts"
>
  {{ section_header }}

  <div class="carousel swiper">
    <div class="carousel__wrapper swiper-wrapper">
      {%- if section.settings.display_type == 'selected' and section.blocks.size > 0 -%}
        {%- assign article_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'article' -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign article_index = article_index | plus: 1 -%}

          <div class="carousel__slide swiper-slide">
            {%- if block.settings.article != blank -%}
              {%- if has_featured_video and replace_article_position == article_index -%}
                {%
                  render 'article-item' with
                  blog_article: block.settings.article,
                  aspect_ratio: section.settings.aspect_ratio,
                  show_author: section.settings.show_author,
                  show_date: section.settings.show_date,
                  show_tags: section.settings.show_tags,
                  show_excerpt: section.settings.show_excerpt,
                  show_featured_image: section.settings.show_featured_image,
                  show_read_button: false,
                  use_featured_video: true,
                  featured_video_url: featured_video_url,
                  featured_video_label: featured_video_label
                %}
              {%- else -%}
                {%
                  render 'article-item' with
                  blog_article: block.settings.article,
                  aspect_ratio: section.settings.aspect_ratio,
                  show_author: section.settings.show_author,
                  show_date: section.settings.show_date,
                  show_tags: section.settings.show_tags,
                  show_excerpt: section.settings.show_excerpt,
                  show_featured_image: section.settings.show_featured_image,
                  show_read_button: false
                %}
              {%- endif -%}
            {%- else -%}
              {% render 'article-item' with aspect_ratio: section.settings.aspect_ratio %}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- elsif section.settings.display_type == 'all' and blog != blank and blog.articles.size > 0 -%}
        {%- for blog_article in blog.articles limit: section.settings.max_articles -%}
          <div class="carousel__slide swiper-slide">
            {%- if has_featured_video and replace_article_position == forloop.index -%}
              {%
                render 'article-item' with
                blog_article: blog_article,
                blog: blog,
                aspect_ratio: section.settings.aspect_ratio,
                show_author: section.settings.show_author,
                show_date: section.settings.show_date,
                show_tags: section.settings.show_tags,
                show_excerpt: section.settings.show_excerpt,
                show_featured_image: section.settings.show_featured_image,
                show_read_button: false,
                use_featured_video: true,
                featured_video_url: featured_video_url,
                featured_video_label: featured_video_label
              %}
            {%- else -%}
              {%
                render 'article-item' with
                blog_article: blog_article,
                blog: blog,
                aspect_ratio: section.settings.aspect_ratio,
                show_author: section.settings.show_author,
                show_date: section.settings.show_date,
                show_tags: section.settings.show_tags,
                show_excerpt: section.settings.show_excerpt,
                show_featured_image: section.settings.show_featured_image,
                show_read_button: false
              %}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- elsif section.settings.display_type != 'selected' -%}
        {%- for i in (1..section.settings.max_articles) -%}
          <div class="carousel__slide swiper-slide">
            {% render 'article-item', aspect_ratio: section.settings.aspect_ratio %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_navigation -%}
    <div class="blog-posts__navigation">
      {%- render 'carousel-navigation' with wrapper_class: 'blog-posts__navigation-buttons animation--controls' -%}
    </div>
  {%- endif -%}

  {%- if section.settings.link_text -%}
    <div class="blog-posts__mobile-button">
      {%-
        render 'button-block' with
        wrapper_class: "blog-posts__header-button blog-posts__header-button--mobile section-introduction__button",
        link: section.settings.button_link | default: blog.url,
        label: section.settings.link_text,
        button_style: "btn--callout",
        icon: "arrow-long",
        view_box_custom: "0 0 16 9"
      -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"],
    "templates": ["password"]
  },
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "t:sections.blog_posts.settings.heading.label",
      "default": "Blog posts"
    },
    {
      "id": "button_link",
      "type": "url",
      "label": "t:shared.settings.button_link.label"
    },
    {
      "id": "link_text",
      "type": "text",
      "label": "t:shared.settings.button_link_text.label",
      "default": "View all posts"
    },
    {
      "type": "radio",
      "id": "display_type",
      "label": "t:sections.blog_posts.settings.display_type.label",
      "info": "t:sections.blog_posts.settings.display_type.info",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "t:sections.blog_posts.settings.display_type.options_all"
        },
        {
          "value": "selected",
          "label": "t:sections.blog_posts.settings.display_type.options_selected"
        }
      ]
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.settings.blog.label"
    },
    {
      "type": "range",
      "id": "max_articles",
      "label": "t:sections.blog_posts.settings.max_articles.label",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.article_options__header.content"
    },
    {
      "id": "show_tags",
      "type": "checkbox",
      "label": "t:sections.blog_posts.settings.show_tags.label",
      "default": true
    },
    {
      "id": "show_author",
      "type": "checkbox",
      "label": "t:sections.blog_posts.settings.show_author.label",
      "default": true
    },
    {
      "id": "show_date",
      "type": "checkbox",
      "label": "t:sections.blog_posts.settings.show_date.label",
      "default": true
    },
    {
      "id": "show_excerpt",
      "type": "checkbox",
      "label": "t:sections.blog_posts.settings.show_excerpt.label",
      "default": true
    },
    {
      "id": "show_featured_image",
      "type": "checkbox",
      "label": "t:sections.blog_posts.settings.show_featured_image.label",
      "default": true
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:sections.blog_posts.settings.aspect_ratio.label",
      "default": "portrait_alt",
      "options": [
        {
          "value": "natural",
          "label": "t:shared.settings.aspect_ratio.option_natural"
        },
        {
          "value": "square",
          "label": "t:shared.settings.aspect_ratio.option_square"
        },
        {
          "value": "portrait",
          "label": "t:shared.settings.aspect_ratio.option_portrait"
        },
        {
          "value": "portrait_alt",
          "label": "t:shared.settings.aspect_ratio.option_portrait_alt"
        },
        {
          "value": "landscape",
          "label": "t:shared.settings.aspect_ratio.option_landscape"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.slider_options__header.content"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:shared.settings.show_navigation_buttons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:shared.settings.section_style.header_style.content"
    },
    {
      "id": "enable_animation",
      "type": "checkbox",
      "label": "t:shared.settings.section_style.enable_animation.label",
      "info": "t:shared.settings.section_style.enable_animation.info",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:shared.settings.section_style.divider_style.label",
      "default": "none",
      "options": [
        {
          "label": "t:shared.settings.section_style.divider_style.option_none",
          "value": "none"
        },
        {
          "label": "t:shared.settings.section_style.divider_style.option_solid",
          "value": "solid"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_padding",
      "label": "t:shared.settings.section_style.section_padding.label",
      "default": "section--vertical-padding-top-bottom",
      "options": [
        {
          "label": "t:shared.settings.section_style.section_padding.option_none",
          "value": "section--vertical-padding-none"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_both",
          "value": "section--vertical-padding-top-bottom"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_top",
          "value": "section--vertical-padding-top-only"
        },
        {
          "label": "t:shared.settings.section_style.section_padding.option_bottom",
          "value": "section--vertical-padding-bottom-only"
        }
      ]
    },
    {
      "type": "select",
      "id": "link_color_scheme",
      "label": "t:shared.settings.link_color_scheme.label",
      "options": [
        {
          "value": "light",
          "label": "t:shared.settings.link_color_scheme.option_light"
        },
        {
          "value": "dark",
          "label": "t:shared.settings.link_color_scheme.option_dark"
        }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "t:sections.blog_posts.blocks.article.name",
      "limit": 16,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "t:sections.blog_posts.blocks.article.settings.article.label"
        }
      ]
    },
    {
      "type": "video",
      "name": "t:sections.blog_posts.blocks.video.name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.blog_posts.blocks.video.settings.video__header.content"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "t:sections.video_hero.settings.video_url.label",
          "info": "t:sections.video_hero.settings.video_url.info"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "t:sections.blog_posts.blocks.video.settings.overlay_text.label",
          "default": "User Created Recipe"
        },
        {
          "type": "text",
          "id": "replace_article_position",
          "label": "t:sections.blog_posts.blocks.video.settings.replace_article_position.label",
          "info": "t:sections.blog_posts.blocks.video.settings.replace_article_position.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.name"
    }
  ]
}
{% endschema %}
